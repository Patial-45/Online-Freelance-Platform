{
  "version": 2,
  "builds": [
    {
      "src": "Client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "Server/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/Server/server.js"
    },
    {
      "src": "/JobsFetch",
      "dest": "/Server/server.js"
    },
    {
      "src": "/FreelancersFetch",
      "dest": "/Server/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/Client/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/Client/index.html"
    }
  ]
}